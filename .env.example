# Required application backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers - configure only the providers you enable
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=
MAIN_AI_SUMMARY_FIRST=false

# Research and deployment integrations
TAVILY_API_KEY=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
GITHUB_TOKEN=

# Trading market-data integrations
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# Server-only administrative access; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Personal Coding Agent Runner (same long random value in Vercel and on your PC)
CODING_AGENT_RUNNER_TOKEN=
BUDDIES_APP_URL=https://your-buddies-domain.vercel.app
BUDDIES_RUNNER_WORKSPACE=C:\BuddiesRunner
BUDDIES_RUNNER_ID=personal-pc
CODEX_BIN=codex
